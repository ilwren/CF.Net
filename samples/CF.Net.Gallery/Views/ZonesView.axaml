<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CFNet.Gallery.ViewModels"
             x:Class="CFNet.Gallery.Views.ZonesView"
             x:DataType="vm:ZonesViewModel">

  <DockPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="16,14,16,6">
      <TextBlock Classes="h1" Text="{Binding Title}" />
      <TextBlock Classes="hint" Text="{Binding Description}" Margin="0,4,0,2" />
      <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
      <TabControl>

        <!-- ============================ zones ============================ -->
        <TabItem Header="Zones">
          <StackPanel Orientation="Vertical" MaxWidth="900" HorizontalAlignment="Left" Margin="0,10,0,0">

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="List zones  -  GET /zones" />
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Page" />
                    <TextBox Text="{Binding ListPage, Mode=TwoWay}" Width="90" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Per page" />
                    <TextBox Text="{Binding ListPerPage, Mode=TwoWay}" Width="90" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Status" />
                    <ComboBox ItemsSource="{Binding ZoneStatuses}" SelectedItem="{Binding ListStatus, Mode=TwoWay}" Width="160" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Name (exact)" />
                    <TextBox Text="{Binding ListName, Mode=TwoWay}" Width="220" PlaceholderText="example.com" />
                  </StackPanel>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="List" Command="{Binding ListCommand}" Margin="0,0,8,0" />
                  <Button Content="List every page" Command="{Binding ListAllCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="One zone  -  GET /zones/{zone_id}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Zone id" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding GetZoneId, Mode=TwoWay}" MinWidth="420" PlaceholderText="blank = the default zone id from the Credentials page" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Domain" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding GetZoneName, Mode=TwoWay}" MinWidth="420" PlaceholderText="example.com" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Get by id" Command="{Binding GetCommand}" Margin="0,0,8,0" />
                  <Button Content="Get by name" Command="{Binding GetByNameCommand}" Margin="0,0,8,0" />
                  <Button Content="Activation check" Command="{Binding ActivationCheckCommand}" Margin="0,0,8,0" />
                  <Button Content="Delete zone" Command="{Binding DeleteZoneCommand}" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox IsChecked="{Binding Paused, Mode=TwoWay}" Content="Paused" VerticalAlignment="Center" />
                  <Button Content="Apply paused state" Command="{Binding SetPausedCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Add a domain  -  POST /zones" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Domain" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding CreateZoneName, Mode=TwoWay}" MinWidth="420" PlaceholderText="example.com" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Type" />
                    <ComboBox ItemsSource="{Binding ZoneTypes}" SelectedItem="{Binding CreateZoneType, Mode=TwoWay}" Width="160" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Account id" />
                    <TextBox Text="{Binding CreateZoneAccount, Mode=TwoWay}" Width="320" PlaceholderText="blank = default account" />
                  </StackPanel>
                </WrapPanel>
                <Button Classes="run" Content="Create zone" Command="{Binding CreateCommand}" />
                <TextBlock Classes="hint" Text="Adding a domain changes the account's DNS - Cloudflare replies with the nameservers to set at the registrar, and the zone stays pending until they are delegated." />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Purge cache  -  POST /zones/{zone_id}/purge_cache" />
                <CheckBox IsChecked="{Binding PurgeEverything, Mode=TwoWay}" Content="Purge everything (slow, and it empties the whole cache)" />
                <TextBox Text="{Binding PurgeUrls, Mode=TwoWay}" AcceptsReturn="True" Height="70"
                         PlaceholderText="one absolute URL per line, e.g. https://example.com/a.css" />
                <TextBox Text="{Binding PurgeTags, Mode=TwoWay}" AcceptsReturn="True" Height="60"
                         PlaceholderText="one cache tag per line (Enterprise)" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Zone id" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding PurgeZoneId, Mode=TwoWay}" MinWidth="420" PlaceholderText="blank = default zone id" />
                </StackPanel>
                <Button Classes="run" Content="Purge" Command="{Binding PurgeCacheCommand}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </TabItem>

        <!-- ============================ dns ============================ -->
        <TabItem Header="DNS records">
          <StackPanel Orientation="Vertical" MaxWidth="900" HorizontalAlignment="Left" Margin="0,10,0,0">

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="List records  -  GET /zones/{zone_id}/dns_records" />
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Type" />
                    <ComboBox ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding DnsListType, Mode=TwoWay}" Width="130" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Name" />
                    <TextBox Text="{Binding DnsListName, Mode=TwoWay}" Width="260" PlaceholderText="www.example.com" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Per page" />
                    <TextBox Text="{Binding DnsListPerPage, Mode=TwoWay}" Width="90" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Zone id" />
                    <TextBox Text="{Binding DnsListZoneId, Mode=TwoWay}" Width="300" PlaceholderText="blank = default zone id" />
                  </StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Find name" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsFindName, Mode=TwoWay}" MinWidth="380" PlaceholderText="www.example.com" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="List" Command="{Binding DnsListCommand}" Margin="0,0,8,0" />
                  <Button Content="List every page" Command="{Binding DnsListAllCommand}" Margin="0,0,8,0" />
                  <Button Content="Find by name" Command="{Binding DnsFindCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Create a record  -  POST /zones/{zone_id}/dns_records" />
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Type" />
                    <ComboBox ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding DnsCreateType, Mode=TwoWay}" Width="130" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="TTL (1 = auto)" />
                    <TextBox Text="{Binding DnsCreateTtl, Mode=TwoWay}" Width="110" />
                  </StackPanel>
                  <StackPanel Orientation="Vertical" Spacing="3" Margin="0,0,16,8">
                    <TextBlock Classes="hint" Text="Priority (MX/SRV)" />
                    <TextBox Text="{Binding DnsCreatePriority, Mode=TwoWay}" Width="130" />
                  </StackPanel>
                  <CheckBox IsChecked="{Binding DnsCreateProxied, Mode=TwoWay}" Content="Proxied" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Name" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsCreateName, Mode=TwoWay}" MinWidth="420" PlaceholderText="www.example.com" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Content" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsCreateContent, Mode=TwoWay}" MinWidth="420" PlaceholderText="192.0.2.1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Comment" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsCreateComment, Mode=TwoWay}" MinWidth="420" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Zone id" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsCreateZoneId, Mode=TwoWay}" MinWidth="420" PlaceholderText="blank = default zone id" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Create record" Command="{Binding DnsCreateCommand}" Margin="0,0,8,0" />
                  <Button Content="as A / AAAA" Command="{Binding DnsCreateAddressCommand}" Margin="0,0,8,0" />
                  <Button Content="as CNAME" Command="{Binding DnsCreateCnameCommand}" Margin="0,0,8,0" />
                  <Button Content="as TXT" Command="{Binding DnsCreateTxtCommand}" />
                </WrapPanel>
                <TextBlock Classes="hint" Text="The three buttons on the right are the convenience overloads: they fill in the type for you from the boxes above, and the TXT one drops the proxied flag because a TXT record cannot be proxied. Same endpoint, same body, less to get wrong." TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="The library picks the type from DnsRecordTypes and validates the record before sending, so an A record without an address fails here rather than in Cloudflare." />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="One record  -  GET / PATCH / PUT / DELETE /zones/{zone_id}/dns_records/{record_id}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Record id" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsRecordId, Mode=TwoWay}" MinWidth="420" PlaceholderText="copy it from a list result" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="New content" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnsUpdateContent, Mode=TwoWay}" MinWidth="420" PlaceholderText="only sent when non-blank" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Get" Command="{Binding DnsGetCommand}" Margin="0,0,8,0" />
                  <Button Content="Update (PATCH)" Command="{Binding DnsUpdateCommand}" Margin="0,0,8,0" />
                  <Button Content="Replace (PUT)" Command="{Binding DnsReplaceCommand}" Margin="0,0,8,0" />
                  <Button Content="Delete" Command="{Binding DnsDeleteCommand}" />
                </WrapPanel>
                <TextBlock Classes="hint" Text="PATCH and PUT are not the same call. The PATCH above sends only the fields you filled in and leaves everything else alone; the PUT replaces the record wholesale with the boxes from the Create card, so a field you leave empty really does go empty. Use PUT when you mean 'this is the record now'." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Zone file  -  GET and POST /zones/{zone_id}/dns_records/export and /import" />
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Classes="hint" Text="BIND zone file to import - export one first, edit it, paste it back" />
                  <TextBox Text="{Binding ZoneFile, Mode=TwoWay}" AcceptsReturn="True" Height="120"
                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                           PlaceholderText=";; A records&#x0a;www.example.com.  1 IN A 192.0.2.1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="proxied" Width="110" VerticalAlignment="Center" />
                  <TextBox Text="{Binding ImportProxied, Mode=TwoWay}" MinWidth="200" PlaceholderText="true / false / blank" />
                  <Button Content="Export" Command="{Binding ExportZoneFileCommand}" Margin="16,0,8,0" VerticalAlignment="Center" />
                  <Button Classes="run" Content="Import" Command="{Binding ImportZoneFileCommand}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" Text="Export answers with the zone file itself rather than a JSON envelope, so the typed result is the text verbatim, and empty when the zone has no records. Import posts it as a multipart form - which is why the request pane below shows a file part instead of JSON - and proxied is documented as the strings true and false rather than a JSON boolean. Leaving it blank lets Cloudflare keep whatever each record's own comment says." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          </StackPanel>
        </TabItem>

        <!-- ============================ DNSSEC ============================ -->
        <TabItem Header="DNSSEC">
          <StackPanel Orientation="Vertical" MaxWidth="900" HorizontalAlignment="Left" Margin="0,10,0,0">

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="DNSSEC state  -  GET /zones/{zone_id}/dnssec" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Zone id" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnssecZoneId, Mode=TwoWay}" MinWidth="380" PlaceholderText="blank uses the configured default zone" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Get DNSSEC" Command="{Binding GetDnssecCommand}" Margin="0,0,8,0" />
                  <Button Content="List Zone Signing Keys" Command="{Binding ListDnssecZsksCommand}" />
                </WrapPanel>
                <TextBlock Classes="hint" Text="The result carries the DS record as one string plus the parts it is assembled from - key tag, algorithm, digest, digest type - so either form can be handed to a registrar. Permissions are DNS Read and DNS Write, not the zone settings ones, which is why this is its own service rather than another zone setting." TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="The ZSK list comes back in PascalCase - DNSKEY, Hdr, Rdlength - because Cloudflare serialises DNS library structs there, unlike every other endpoint. Two of its five fields have no published type, so they arrive untyped rather than guessed." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Enable, disable, delete  -  PATCH and DELETE /zones/{zone_id}/dnssec" />
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Enable" Command="{Binding EnableDnssecCommand}" Margin="0,0,8,0" />
                  <Button Content="Disable" Command="{Binding DisableDnssecCommand}" Margin="0,0,8,0" />
                  <Button Content="Delete the records" Command="{Binding DeleteDnssecCommand}" />
                </WrapPanel>
                <TextBlock Classes="hint" Text="Enabling is two phases and only the first is ours: the call sends status active, the zone reports pending, and it stays pending until the DS record above is published at the registrar, at which point it becomes active. Get DNSSEC again to watch that happen." TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="Disabling mirrors it with its own waiting state, pending-disabled, which lasts until the registrar drops the DS record. Remove the DS record at the registrar first: turning signing off while it is still published breaks resolution for validating resolvers." TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="Delete removes the records without going through either waiting state, and its result is a bare string rather than an object - one of the few endpoints in the API that answers that way, so the result pane shows the text itself." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Signing switches  -  PATCH /zones/{zone_id}/dnssec" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Multi-signer" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnssecMultiSigner, Mode=TwoWay}" MinWidth="380" PlaceholderText="true, false, or blank to leave it" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Presigned" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnssecPresigned, Mode=TwoWay}" MinWidth="380" PlaceholderText="true, false, or blank to leave it" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Use NSEC3" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding DnssecUseNsec3, Mode=TwoWay}" MinWidth="380" PlaceholderText="true, false, or blank to leave it" />
                </StackPanel>
                <Button Classes="run" Content="Patch the switches" Command="{Binding UpdateDnssecSigningCommand}" />
                <TextBlock Classes="hint" Text="This PATCH merges: only the boxes that are filled in are sent, so the enabled state is untouched when only switches change. Multi-signer lets several providers sign the same zone and is required before DNSKEY records other than Cloudflare's own can be added; presigned lets an already-signed zone transfer in as secondary; NSEC3 replaces NSEC, generated per request unless presigned is on." TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="Only two of the five statuses can be asked for - active and disabled - and a body that changes nothing is refused here rather than sent. pending, pending-disabled and error are states Cloudflare reports, not instructions. A box holding anything other than true, 1, yes, false, 0 or no counts as blank, so a typo leaves that switch alone instead of sending nonsense." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          </StackPanel>
        </TabItem>

        <!-- ============================ settings ============================ -->
        <TabItem Header="Settings">
          <StackPanel Orientation="Vertical" MaxWidth="900" HorizontalAlignment="Left" Margin="0,10,0,0">

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Every setting  -  GET /zones/{zone_id}/settings" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Zone" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SettingZoneId, Mode=TwoWay}" MinWidth="380" PlaceholderText="blank uses the zone from the Credentials page" />
                </StackPanel>
                <Button Classes="run" Content="List settings" Command="{Binding ListSettingsCommand}" />
                <TextBlock Classes="hint" Text="Cloudflare marks this deprecated in favour of reading one setting at a time, but it is still the only way to discover which settings a zone has and what shape each value takes - which ones exist depends on the plan. It is also the cheapest snapshot to take before changing anything, and the result is a plain array, so there is nothing to page through." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="One setting  -  GET and PATCH /zones/{zone_id}/settings/{setting_id}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="Setting id" Width="140" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SettingId, Mode=TwoWay}" MinWidth="380" PlaceholderText="always_online, ssl, security_level ..." />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Classes="run" Content="Get" Command="{Binding GetSettingCommand}" Margin="0,0,8,0" />
                  <CheckBox IsChecked="{Binding SettingOn, Mode=TwoWay}" Content="on" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Content="Switch on / off" Command="{Binding SetSettingOnOffCommand}" Margin="0,0,8,0" />
                </WrapPanel>
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Classes="hint" Text="Value to send, as JSON - a string, a number, an object or an array" />
                  <TextBox Text="{Binding SettingValueJson, Mode=TwoWay}" MinWidth="520" HorizontalAlignment="Left"
                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                           PlaceholderText='"on"' />
                </StackPanel>
                <Button Content="Set value" Command="{Binding SetSettingValueCommand}" />
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Classes="hint" Text='Or write the body yourself: {"value": ...} or {"enabled": ...}' />
                  <TextBox Text="{Binding SettingBodyJson, Mode=TwoWay}" MinWidth="520" HorizontalAlignment="Left"
                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                           PlaceholderText='e.g. {"value":"under_attack"} or {"enabled":true}' />
                </StackPanel>
                <Button Content="Patch with this body" Command="{Binding UpdateSettingCommand}" />
                <TextBlock Classes="hint" Text="Values are not all the same shape: some settings take a string such as on, some a number, some an object, and the switch sends the strings on and off rather than a boolean. Each entry reports editable, so read before writing. A hand-written body must carry either a value or an enabled flag - sending neither, or both, is refused here rather than by Cloudflare." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Classes="h2" Text="Several settings  -  PATCH /zones/{zone_id}/settings" />
                <StackPanel Orientation="Vertical" Spacing="3">
                  <TextBlock Classes="hint" Text="Array of changes, each with an id and a value" />
                  <TextBox Text="{Binding BulkSettingsJson, Mode=TwoWay}" AcceptsReturn="True" Height="110"
                           FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                           PlaceholderText='[{"id":"always_online","value":"on"},{"id":"security_level","value":"high"}]' />
                </StackPanel>
                <Button Classes="run" Content="Patch all of them" Command="{Binding BulkUpdateSettingsCommand}" />
                <TextBlock Classes="hint" Text="The body is an array of {id, value} objects, not an object keyed by setting id, which is the shape that is easy to get wrong. Cloudflare marks this endpoint deprecated too, and applies it all-or-nothing: one setting it rejects fails the whole call and nothing changes." TextWrapping="Wrap" />
              </StackPanel>
            </Border>

          </StackPanel>
        </TabItem>

      </TabControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>
